{
  "name": "dsh-ue-db",
  "version": "1.0.0",
  "description": "Offline Unreal Engine 5.8 database for DeepSeek Harness: 52k Blueprint API nodes with pin tables, 30k C++ API classes, 11.6k Python API classes and 3.6k Epic guide pages, searchable without network access. Corpus is downloaded on first use.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/db.js",
    "lib/paths.js",
    "lib/update.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "tools/build_index.py",
    "tools/check_db.py",
    "tools/check_language.mjs",
    "tools/check_package.mjs",
    "tools/check_queries.mjs",
    "tools/crawl.py",
    "tools/crawl_bpapi.py",
    "tools/crawl_cpp_core.py",
    "tools/crawl_cppapi.py",
    "tools/crawl_pyapi.py",
    "tools/dbpaths.py",
    "tools/epic.py",
    "tools/fetch_cpp_priority.py",
    "tools/fix_guide_categories.py",
    "tools/mdconv.py"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "unreal-engine",
    "unreal",
    "blueprint",
    "knowledge-base",
    "offline-docs",
    "rag"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abeskandr/dsh-ue-db.git"
  },
  "homepage": "https://github.com/Abeskandr/dsh-ue-db#readme",
  "bugs": {
    "url": "https://github.com/Abeskandr/dsh-ue-db/issues"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/Abeskandr/dsh-ue-db/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/Abeskandr/dsh-ue-db/zip/refs/heads/main",
      "git": "https://github.com/Abeskandr/dsh-ue-db.git"
    }
  }
}
